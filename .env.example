# VAYUWISE AI - Environment Configuration Example
# All credentials are completely optional for local development and evaluation.
# Without credentials, VAYUWISE AI operates in fully functional, clearly labeled Demo Mode.

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generative AI (Google Gemini via official @google/genai SDK)
# Server-side only; never expose to frontend bundles.
# When omitted, VAYUWISE AI runs its Deterministic Environmental Health Engine fallback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK (Server-Side)
# Optional: If omitted, server runs in transparent DEMO mode with in-memory persistence.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Vite Frontend)
# Optional: If omitted, frontend runs in transparent DEMO mode with in-memory persistence.
VITE_FIREBASE_API_KEY=your_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Live Environmental Data Providers
# Primary live data: Open-Meteo Copernicus CAMS (Free, live atmospheric reanalysis - requires NO key and is enabled out-of-the-box).
# Optional physical ground monitoring: OpenAQ v3 API Key (Optional: when provided, queries nearby physical monitoring stations).
OPENAQ_API_KEY=
