# VAYUWISE AI - Environment Configuration Example

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generative AI (Google Gemini)
# Must only be set on the server-side, never exposed to client
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK (Server-Side)
# Optional: If omitted, server runs in transparent DEMO mode with mock verified credentials
FIREBASE_PROJECT_ID=vayuwise-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vayuwise-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Vite Frontend)
# Optional: If omitted, frontend runs in transparent DEMO mode with in-memory persistence
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyVayuwiseFrontendClient
VITE_FIREBASE_AUTH_DOMAIN=vayuwise-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vayuwise-demo
VITE_FIREBASE_STORAGE_BUCKET=vayuwise-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Live Environmental Data Providers (Optional)
# If omitted or quota exceeded, system uses authentic fallback telemetry with clear DEMO labels
OPENAQ_API_KEY=
AQICN_API_TOKEN=
