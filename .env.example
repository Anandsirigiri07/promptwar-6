# VAYUWISE AI - Environment Configuration Example
# All credentials are completely optional for local development and evaluation.
# Without credentials, VAYUWISE AI operates in fully functional, clearly labeled Demo Mode.

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generative AI (Google Gemini via official @google/genai SDK)
# Server-side only; never expose to frontend bundles.
# When omitted, VAYUWISE AI runs its Deterministic Environmental Health Engine fallback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# FIREBASE FREE TIER (SPARK PLAN) CONFIGURATION
# 100% Free - $0/month - No credit card required!
# Step-by-step guide: docs/FIREBASE_FREE_TIER_SETUP.md
# ==============================================================================

# 1. Firebase Admin SDK (Server-Side)
# From: Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key"
# Optional: If omitted, server runs in transparent DEMO mode with in-memory persistence.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# 2. Firebase Client SDK (Vite Frontend)
# From: Firebase Console -> Project Settings -> General -> "Your apps" (Web </> App)
# Optional: If omitted, frontend runs in transparent DEMO mode with in-memory persistence.
VITE_FIREBASE_API_KEY=AIzaSyYourClientApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# 3. Optional Local Firebase Emulator Suite (Offline, zero-quota local dev)
# Set to 'true' if running `firebase emulators:start` locally
VITE_FIREBASE_USE_EMULATOR=false
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ==============================================================================
# ENVIRONMENTAL DATA PROVIDERS
# ==============================================================================
# Primary live data: Open-Meteo Copernicus CAMS (Free, live atmospheric reanalysis - requires NO key and is enabled out-of-the-box).
# Optional physical ground monitoring: OpenAQ v3 API Key (Optional: when provided, queries nearby physical monitoring stations).
OPENAQ_API_KEY=
