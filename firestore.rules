rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authorization and data integrity
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User profile and private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /preferences/{preferenceId} {
        allow read, write: if isOwner(userId);
      }
      
      match /savedRoutines/{routineId} {
        allow read, write: if isOwner(userId);
      }
      
      match /rooms/{roomId} {
        allow read, write: if isOwner(userId);
      }
      
      match /reports/{reportId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Community public read, authenticated pledge creation
    // Direct client mutation of counters (completedCount, estimatedCO2SavingsKg) is strictly disallowed
    match /communityPledges/{pledgeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow user to edit only descriptive text, never counters or aggregate impacts
      allow update: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.completedCount == resource.data.completedCount &&
                    request.resource.data.estimatedCO2SavingsKg == resource.data.estimatedCO2SavingsKg &&
                    request.resource.data.estimatedPM25AvoidedGrams == resource.data.estimatedPM25AvoidedGrams &&
                    request.resource.data.participants == resource.data.participants;
      allow delete: if false; // Pledges are immutable once completed
    }
    
    // Community action logs: private to the owner who logged the action
    // Public reads of action logs are prohibited to protect personal notes and user IDs
    match /communityActions/{actionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Actions are append-only audit trail
    }
    
    // Aggregates are server-managed only (Firebase Admin / Cloud Functions)
    match /communityAggregates/{aggregateId} {
      allow read: if true;
      allow write: if false; // Direct client modification disallowed to prevent fraudulent inflation
    }

    // Idempotency keys are server-managed only
    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }
    
    // Default deny all other unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}