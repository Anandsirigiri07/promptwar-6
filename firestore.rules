rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authorization and data integrity
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User profile and private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /preferences/{preferenceId} {
        allow read, write: if isOwner(userId);
      }
      
      match /savedRoutines/{routineId} {
        allow read, write: if isOwner(userId);
      }
      
      match /rooms/{roomId} {
        allow read, write: if isOwner(userId);
      }
      
      match /reports/{reportId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Community public read, authenticated pledge creation
    match /communityPledges/{pledgeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false; // Pledges are immutable once completed or deleted only by admin
    }
    
    // Community verified action logs
    match /communityActions/{actionId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Actions are append-only audit trail
    }
    
    // Aggregates are server-managed only (Firebase Admin / Cloud Functions)
    match /communityAggregates/{aggregateId} {
      allow read: if true;
      allow write: if false; // Direct client modification disallowed to prevent fraudulent inflation
    }
    
    // Default deny all other unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
